# Optional: YouTube Data API v3 key (enrich duration/viewCount in fetch_releases.py)
# YouTube Music catalog itself is collected via ytmusicapi (no key required).
YT_API_KEY=

# Firebase web app config (public client config — safe to expose in the bundle)
# App GA config is baked into src/lib/firebase.ts; these are for scripts / CI mirror.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
