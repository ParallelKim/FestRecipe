# Optional: YouTube Data API v3 key (enrich duration/viewCount in fetch_releases.py)
# YouTube Music catalog itself is collected via ytmusicapi (no key required).
YT_API_KEY=

# Firebase web app config (public client config — safe to expose in the bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# GA4 measurement ID — Firebase Console > Project settings > Web app / Google Analytics
VITE_FIREBASE_MEASUREMENT_ID=
